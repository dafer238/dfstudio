"Vapour-compression refrigeration cycle (R134a) — engineering units (C, bar, kJ)"
$UnitSystem Eng

T_evap = -10 [C]
T_cond = 40 [C]
dT_sh = 5 [dK]                 "superheat at the compressor inlet"
dT_sc = 3 [dK]                 "subcooling at the condenser outlet"
eta_c = 0.75
Q_evap = 10 [kW]               "cooling capacity"

P[1] = p_sat(R134a, T=T_evap)
T[1] = T_evap + dT_sh
h[1] = enthalpy(R134a, T=T[1], P=P[1])
s[1] = entropy(R134a, T=T[1], P=P[1])
P[2] = p_sat(R134a, T=T_cond)
h_s[2] = enthalpy(R134a, P=P[2], s=s[1])
eta_c = (h_s[2] - h[1]) / (h[2] - h[1])
T[2] = temperature(R134a, P=P[2], h=h[2])
P[3] = P[2]
T[3] = T_cond - dT_sc
h[3] = enthalpy(R134a, T=T[3], P=P[3])
"throttling valve: isenthalpic"
P[4] = P[1]
h[4] = h[3]
T[4] = temperature(R134a, P=P[4], h=h[4])
x[4] = quality(R134a, P=P[4], h=h[4])

Q_evap = m_dot*(h[1] - h[4])   {kW}
W_c = m_dot*(h[2] - h[1])      {kW}
Q_cond = m_dot*(h[2] - h[3])   {kW}
COP = Q_evap/W_c
