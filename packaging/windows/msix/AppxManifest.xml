<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX package manifest for DeltaF Studio. build_msix.ps1 fills in the
     @...@ values: the identity from store-identity.json and the version from
     Cargo.toml (as X.Y.Z.0; the Microsoft Store needs the last field 0).
     The package holds the desktop app only. The dfs command-line solver
     would need a second application without a Start menu entry
     (AppListEntry="none"), which the Store accepts only with a
     HeadlessAppBypass waiver, and one application can have only one
     execution alias extension. dfs comes with the installer and winget. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="@IdentityName@" Publisher="@Publisher@" Version="@Version@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeltaF Studio</DisplayName>
    <PublisherDisplayName>@PublisherDisplayName@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DeltaFStudio" Executable="dfstudio.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="DeltaF Studio" Description="Equation solver for engineering models, with thermodynamic properties and cycle tools"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="DeltaF Studio" />
      </uap:VisualElements>
      <Extensions>
        <!-- "dfstudio" runs from any terminal and from Win+R -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="dfstudio.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="dfstudio.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- double-click opens the file: the path is passed as the first argument -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="dfstudio-project">
            <uap:DisplayName>DeltaF Studio project</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.df</uap:FileType>
              <uap:FileType>.dfs</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="ees-model">
            <uap:DisplayName>EES model</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.ees</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>

  </Applications>

  <Capabilities>
    <!-- a desktop (Win32) program; the Store accepts this for packaged desktop apps -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
